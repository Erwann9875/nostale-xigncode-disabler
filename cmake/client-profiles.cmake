# Build-time client allowlist. This is not a runtime override mechanism.
set(profile_source "${CMAKE_CURRENT_SOURCE_DIR}/contracts/client-profiles.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${profile_source}")
file(READ "${profile_source}" profile_json)
string(JSON profile_schema GET "${profile_json}" schema_version)
if(NOT profile_schema EQUAL 1)
    message(FATAL_ERROR "Unsupported client profile schema")
endif()
foreach(field IN ITEMS layout file_version disk_size preferred_base)
    string(JSON profile_${field} GET "${profile_json}" ${field})
endforeach()
string(JSON profile_count LENGTH "${profile_json}" profiles)
if(profile_count LESS 1)
    message(FATAL_ERROR "The client allowlist must not be empty")
endif()
math(EXPR profile_last "${profile_count} - 1")
set(profile_entries "")
set(profile_hashes "")
set(profile_ids "")
foreach(index RANGE ${profile_last})
    string(JSON id GET "${profile_json}" profiles ${index} id)
    string(JSON hash GET "${profile_json}" profiles ${index} sha256)
    string(LENGTH "${hash}" hash_length)
    if(NOT id MATCHES "^[a-z0-9-]+$" OR NOT hash MATCHES "^[0-9A-F]+$" OR
       NOT hash_length EQUAL 64 OR hash IN_LIST profile_hashes OR id IN_LIST profile_ids)
        message(FATAL_ERROR "Invalid or duplicate audited client profile: ${id}")
    endif()
    list(APPEND profile_hashes "${hash}")
    list(APPEND profile_ids "${id}")
    string(REGEX REPLACE "(..)" "std::byte{0x\\1}, " hash_bytes "${hash}")
    string(APPEND profile_entries "    client_profile{\"${id}\", \"${hash}\", {${hash_bytes}}},\n")
endforeach()
string(JSON profile_name GET "${profile_json}" executable_names 0)
string(JSON profile_alternate_name GET "${profile_json}" executable_names 1)
set(profile_include_directory "${CMAKE_CURRENT_BINARY_DIR}/generated")
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/client_profiles.hpp.in"
    "${profile_include_directory}/nostale_hk/contracts/client_profiles.hpp" @ONLY)
